# ローカル実行用の認証情報。
# このファイルをコピーして .env を作る（.env は gitignore 済み・絶対にコミットしない）。
#
#   cp .env.example .env
#
# リポジトリは public なので、値を書き込むのは .env のみ。
# GitHub Actions で使う分は gh secret set で登録する（.env は CI では読まれない）。

# 豊島区公共施設予約システム（自動予約を使う場合のみ）
TOSHIMA_USER_ID=
TOSHIMA_PASSWORD=

# LINE Messaging API
# LINE_CHANNEL_ACCESS_TOKEN: Developers コンソール →「Messaging API設定」タブ →
#                            「チャネルアクセストークン（長期）」
# LINE_TO:                   Developers コンソール →「チャネル基本設定」タブ →
#                            「あなたのユーザーID」（U で始まる 33 文字）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
